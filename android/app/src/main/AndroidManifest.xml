<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Discovery and, later, the display stream run over the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="VD Client"
        android:hasCode="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!--
            The entry point is the platform's NativeActivity, which loads
            libvd_client.so and calls the exported Rust `android_main` function.
        -->
        <activity
            android:name="android.app.NativeActivity"
            android:label="VD Client"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Must match the [lib] name of the `vd-client` crate. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="vd_client" />
        </activity>
    </application>

</manifest>
