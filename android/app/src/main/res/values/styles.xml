<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Fullscreen, and willing to use the strips either side of a camera
        cutout. The stream is letterboxed to the desktop's aspect ratio, so
        those edges are black or background anyway, and being letterboxed away
        from the cutout would cost screen for nothing.

        minSdk is 31, so the attribute is always understood.
    -->
    <style name="VdFullscreen" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
